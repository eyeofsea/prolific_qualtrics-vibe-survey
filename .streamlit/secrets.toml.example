# 강사용 — 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 토큰을 채워 넣으세요.
# 로컬 실행 시: .streamlit/secrets.toml 은 .gitignore 에 포함되어 커밋되지 않음.
# Streamlit Cloud 배포 시: 이 내용을 share.streamlit.io 대시보드의 Secrets 에 그대로 붙여 넣으세요.

[qualtrics]
api_token = "YOUR_QUALTRICS_API_TOKEN"
data_center = "hnd1"   # 예: hnd1, syd1, yul1, fra1, sjc1, iad1 …

# (선택) 수업용 공유 비밀번호.
# Streamlit Cloud 처럼 공개 URL 로 배포할 때 강력히 권장 — 학생에게만 알려주면 외부인이 강사 토큰을 못 씀.
# 로컬 실행이라면 이 [auth] 섹션을 통째로 지워도 됨 — 비어 있으면 게이트가 비활성화됨.
[auth]
password = "REPLACE_WITH_CLASS_PASSWORD"
